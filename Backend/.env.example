# ============================================================
# BACKEND - Variables de entorno para Veterinaria ITQ
# ============================================================
# Copia este archivo a .env y completa con tus credenciales
# NO subas el archivo .env a GitHub (está en .gitignore)
# ============================================================

# ------------------------------------------------------------
# BASE DE DATOS (PostgreSQL) - REQUERIDO
# ------------------------------------------------------------
# Host del servidor PostgreSQL
VET_DB_HOST=localhost

# Puerto de PostgreSQL
VET_DB_PORT=5432

# Nombre de la base de datos
VET_DB_NAME= nombre de la BD

# Usuario de la base de datos
VET_DB_USER=postgres

# Contraseña de la base de datos (OBLIGATORIA - sin valor por defecto)
VET_DB_PASSWORD= tu contraseña

# ------------------------------------------------------------
# JWT - AUTENTICACIÓN
# ------------------------------------------------------------
# Clave secreta para firmar/verificar tokens JWT (cambiar en producción)
# Genera una clave segura con: openssl rand -base64 32
JWT_SECRET=VETERINARIAITQ_CAMBIAR_ESTA_CLAVE_EN_PRODUCCION_2026

# ------------------------------------------------------------
# CORREO ELECTRÓNICO (SMTP) - REQUERIDO
# ------------------------------------------------------------
# Configuración SMTP para envío de correos (recuperación password, confirmación
# de cuenta y notificaciones). No hay valores por defecto: todas son obligatorias.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER= tu correo electronico o de empresa gmail
SMTP_PASSWORD=  contraseña de "Contraseña aplicaciones de google"Ve a myaccount.google.com/apppasswords (https://myaccount.google.com/apppasswords)
SMTP_FROM_EMAIL= tu correo electronico o de empresa gmail
SMTP_FROM_NAME=Veterinaria ITQ
SMTP_STARTTLS=true
SMTP_AUTH=true

# URL del frontend para enlaces en correos (ej: restablecer contraseña)
FRONTEND_URL=http://localhost:5174

# ------------------------------------------------------------
# CORS - OPCIONAL
# ------------------------------------------------------------
# Origen permitido para CORS (frontend). '*' = todos.
# Desarrollo: http://localhost:5174
# Producción: https://tudominio.com
CORS_ORIGIN=*

# ------------------------------------------------------------
# VALIDACIÓN RUC (SRI) - OPCIONAL
# ------------------------------------------------------------
# Saltar validación contra el SRI en tiempo real (solo para testing/desarrollo)
# true = solo valida formato y duplicados en BD (NO consulta al SRI)
# false = valida formato + duplicados + existencia en SRI (producción)
SRI_VALIDATION_SKIP=true

# ------------------------------------------------------------
# SERVIDOR (Tomcat) - OPCIONAL
# ------------------------------------------------------------
# Puerto donde corre Tomcat (por defecto 8080)
SERVER_PORT=8080

# Contexto de la aplicación (war name)
SERVER_CONTEXT_PATH=/VETERINARIAITQ