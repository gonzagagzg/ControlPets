# ============================================================
# FRONTEND - Variables de entorno para ControlPets
# ============================================================
# Copia este archivo a .env y completa con tus valores
# NO subas el archivo .env a GitHub (está en .gitignore)
# ============================================================

# ------------------------------------------------------------
# API BACKEND - REQUERIDO
# ------------------------------------------------------------
# URL base completa de la API (incluye contexto /VETERINARIAITQ)
# Desarrollo: http://localhost:8080/VETERINARIAITQ
# Producción: https://tudominio.com/VETERINARIAITQ
VITE_API_URL=http://localhost:8080/VETERINARIAITQ

# ------------------------------------------------------------
# SERVIDOR DE DESARROLLO (Vite) - OPCIONAL
# ------------------------------------------------------------
# Puerto del servidor de desarrollo (por defecto 5174)
# VITE_DEV_PORT=5174